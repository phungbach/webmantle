# Copy to .env (never commit .env). Paths are resolved relative to prisma/schema.prisma.
DATABASE_URL="file:../data/cms.db"

# Required in production: at least 32 random characters. Used for preview tokens.
# Generate with: openssl rand -base64 48
PREVIEW_SECRET=""

# Public site URL, used for canonical links, sitemap, RSS and robots.txt
SITE_URL="http://localhost:3000"

# Initial administrator, used only by `npm run db:seed` (password must be 12+ characters)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Set to "true" only when a reverse proxy you control sits in front of the app and overwrites
# x-forwarded-for. Off by default: the header is client-controlled and would let anyone dodge
# the login and tracking rate limits. When off, all clients share one "direct" rate-limit key.
TRUST_PROXY="false"

# Optional read-only demo account (role "viewer"): can open /admin but cannot add, edit or delete.
# Created by `npm run db:seed` when both are set (password 12+ characters).
DEMO_EMAIL=""
DEMO_PASSWORD=""
DEMO_NAME="Demo"
# Set to "true" to enable /demo: it signs visitors in to the read-only demo account above and opens /admin.
DEMO_PUBLIC_LOGIN="false"
