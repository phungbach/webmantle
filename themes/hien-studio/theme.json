    },
    {
      "id": "process",
      "label": "Trang quy trình",
      "description": "Bốn bước làm việc.",
      "appliesTo": ["page"]
    },
    {
      "id": "pricing",
      "label": "Trang báo giá",
      "description": "Gói dịch vụ và đơn giá.",
      "appliesTo": ["page"]
    },
    {
      "id": "about",
      "label": "Trang giới thiệu",
      "description": "Câu chuyện, đội ngũ và số liệu.",
      "appliesTo": ["page"]
    },
    {
      "id": "contact",
      "label": "Trang liên hệ",
      "description": "Địa chỉ và cách đặt lịch.",
      "appliesTo": ["page"]
    }
